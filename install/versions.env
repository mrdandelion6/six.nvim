# versions.env — hardcoded versions for bootstrap.sh
# update these when new versions are released
#
# *_VERSION is what gets downloaded when bootstrap curls a tool (local mode , or
# tree-sitter / stylua in every mode). it is not checked against what's already
# installed. tree-sitter and stylua are the exception: their pin is the exact
# version nvim uses , since bootstrap owns the copy in the nvim-only bin dir.
#
# *_MIN is the oldest version the config works with. only tools with a real
# requirement have one. an existing install older than this gets replaced or
# flagged (see install/README.md)
#
# check releases at:
#   nvim:     https://github.com/neovim/neovim/releases
#   ripgrep:  https://github.com/BurntSushi/ripgrep/releases
#   stylua:   https://github.com/JohnnyMorganz/StyLua/releases
#   quarto:   https://github.com/quarto-dev/quarto-cli/releases
#   zoxide:   https://github.com/ajeetdsouza/zoxide/releases
#   tree-sitter: https://github.com/tree-sitter/tree-sitter/releases
#   uv:       https://github.com/astral-sh/uv/releases
#   nvm:      https://github.com/nvm-sh/nvm/releases

NVIM_VERSION="0.12.6"
RG_VERSION="14.1.1"
STYLUA_VERSION="2.6.0"
QUARTO_VERSION="1.6.40"
ZOXIDE_VERSION="0.9.4"
FD_VERSION="10.1.0"
FZF_VERSION="0.54.0"
TREE_SITTER_VERSION="0.27.2"
UV_VERSION="0.13.10"
NVM_VERSION="0.40.3"
# python version uv uses for the neovim venv (uv downloads it if missing)
NVIM_VENV_PYTHON="3.14"

# minimums
NVIM_MIN="0.12.0"
# node major version , for mason's npm based language servers
NODE_MIN_MAJOR="20"
